# Copy to .env and fill in.
BIND=127.0.0.1:3100
DATABASE=data/vttl-league.sqlite
WEB_DIR=web/dist

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts the VTTL passwords that
# the server keeps for a session. Empty: the server makes data/secret.key on the first start.
SECRET_KEY=

# Session cookie with the Secure flag. Default: off for a 127.0.0.1/localhost BIND, on otherwise.
# COOKIE_SECURE=true

# VTTL_ENDPOINT=https://api.vttl.be/0.7/index.php?s=vttl

# Real uploads to VTTL. Keep false during development: there is no VTTL test database.
UPLOAD_ENABLED=false

# Scoreboards (Flippr / ESP32). Empty: scoreboards are off. Topics: tabletennis/{device}/...
# MQTT_URL=mqtt://127.0.0.1:1883
# MQTT_USER=
# MQTT_PASSWORD=
