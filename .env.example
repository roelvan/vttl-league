# Copy to .env and fill in.
CLUB=WVL154
BIND=127.0.0.1:3100
DATABASE=vttl-league.sqlite

# Optional for reads (higher quota). Required for a real upload.
VTTL_ACCOUNT=
VTTL_PASSWORD=

# Keep true during development: there is no VTTL test database.
DRY_RUN=true

# Scoreboards. Leave MQTT_HOST empty to run without them.
# This user needs write access (config, clear).
MQTT_HOST=mqtt.vaneyghen.be
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER=
MQTT_PASSWORD=
